<div {{ attributes.defaults(stimulus_controller('application-list')) }} class="max-w-6xl mx-auto p-6 transition-opacity duration-150">
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-gray-900">Job Applications</h1>
        <a href="{{ path('apply') }}" class="inline-flex items-center px-3 py-1.5 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
            </svg>
            New Application
        </a>
    </div>

    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 mb-6">
        <form class="flex flex-col sm:flex-row gap-4 items-end" data-action="submit->prevent">
            <div class="w-full sm:w-auto flex-1 sm:flex-initial">
                <label for="status" class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5">Status</label>
                <select name="status" id="status" data-model="status"
                        class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 border">
                    <option value="" {% if status == '' %}selected{% endif %}>All</option>
                    <option value="received" {% if status == 'received' %}selected{% endif %}>Received</option>
                    <option value="enriching" {% if status == 'enriching' %}selected{% endif %}>Enriching</option>
                    <option value="enriched" {% if status == 'enriched' %}selected{% endif %}>Enriched</option>
                </select>
            </div>

            <div class="w-full sm:w-auto flex-1 sm:flex-initial">
                <label for="position" class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5">Position</label>
                <input type="text" name="position" id="position" data-model="position" value="{{ position }}" placeholder="Any position"
                       class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 border">
            </div>

            <div class="w-full sm:w-auto flex-1 sm:flex-initial">
                <label for="search" class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5">Search</label>
                <input type="text" name="search" id="search" data-model="search" value="{{ search }}" placeholder="Name or email"
                       class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 border">
            </div>

            <button type="button" data-action="click->live#action" data-live-action-param="clear"
                    class="inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
                Clear
            </button>
        </form>
    </div>

    {% if this.applications is empty %}
        <div class="text-center py-16 bg-white rounded-lg shadow-sm border border-gray-200">
            <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto h-12 w-12 text-gray-300 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <p class="text-gray-500 text-sm">No applications found.</p>
            <button type="button" data-action="click->live#action" data-live-action-param="clear" class="mt-2 text-sm text-blue-600 hover:text-blue-800 font-medium">
                Clear filters
            </button>
        </div>
    {% else %}
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th scope="col"
                            class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider cursor-pointer hover:text-gray-700 hover:bg-gray-100 transition-colors select-none"
                            data-action="click->live#action" data-live-action-param="sort" data-live-column-param="fullName"
                        >
                            <div class="flex items-center gap-1">
                                Name
                                <span class="text-gray-400">{% if sortBy == 'fullName' %}{{ sortDir == 'asc' ? '↑' : '↓' }}{% else %}↕{% endif %}</span>
                            </div>
                        </th>
                        <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Email</th>
                        <th scope="col"
                            class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider cursor-pointer hover:text-gray-700 hover:bg-gray-100 transition-colors select-none"
                            data-action="click->live#action" data-live-action-param="sort" data-live-column-param="position"
                        >
                            <div class="flex items-center gap-1">
                                Position
                                <span class="text-gray-400">{% if sortBy == 'position' %}{{ sortDir == 'asc' ? '↑' : '↓' }}{% else %}↕{% endif %}</span>
                            </div>
                        </th>
                        <th scope="col"
                            class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider cursor-pointer hover:text-gray-700 hover:bg-gray-100 transition-colors select-none"
                            data-action="click->live#action" data-live-action-param="sort" data-live-column-param="status"
                        >
                            <div class="flex items-center gap-1">
                                Status
                                <span class="text-gray-400">{% if sortBy == 'status' %}{{ sortDir == 'asc' ? '↑' : '↓' }}{% else %}↕{% endif %}</span>
                            </div>
                        </th>
                        <th scope="col"
                            class="px-4 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider cursor-pointer hover:text-gray-700 hover:bg-gray-100 transition-colors select-none"
                            data-action="click->live#action" data-live-action-param="sort" data-live-column-param="score"
                        >
                            <div class="flex items-center justify-end gap-1">
                                Score
                                <span class="text-gray-400">{% if sortBy == 'score' %}{{ sortDir == 'asc' ? '↑' : '↓' }}{% else %}↕{% endif %}</span>
                            </div>
                        </th>
                        <th scope="col"
                            class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider cursor-pointer hover:text-gray-700 hover:bg-gray-100 transition-colors select-none"
                            data-action="click->live#action" data-live-action-param="sort" data-live-column-param="appliedAt"
                        >
                            <div class="flex items-center gap-1">
                                Applied At
                                <span class="text-gray-400">{% if sortBy == 'appliedAt' %}{{ sortDir == 'asc' ? '↑' : '↓' }}{% else %}↕{% endif %}</span>
                            </div>
                        </th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    {% for app in this.applications %}
                        <tr class="hover:bg-gray-50 transition-colors" data-testid="application-row" data-email="{{ app.email }}">
                            <td class="px-4 py-3 whitespace-nowrap">
                                <a href="{{ path('application_detail', {id: app.id}) }}" class="text-sm font-medium text-blue-600 hover:text-blue-800 transition-colors">{{ app.fullName }}</a>
                            </td>
                            <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-600">{{ app.email }}</td>
                            <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900">{{ app.position }}</td>
                            <td class="px-4 py-3 whitespace-nowrap">
                                {% if app.status == 'enriched' %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                        <span class="w-1.5 h-1.5 mr-1.5 rounded-full bg-green-600"></span>
                                        Enriched
                                    </span>
                                {% elseif app.status == 'enriching' %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">
                                        <span class="w-1.5 h-1.5 mr-1.5 rounded-full bg-amber-600"></span>
                                        Enriching
                                    </span>
                                {% else %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                        <span class="w-1.5 h-1.5 mr-1.5 rounded-full bg-gray-500"></span>
                                        Received
                                    </span>
                                {% endif %}
                            </td>
                            <td class="px-4 py-3 whitespace-nowrap text-sm text-right">
                                {% if app.score is not null %}
                                    <span data-testid="application-score" class="inline-flex items-center justify-end gap-1.5 font-semibold {{ app.score >= 80 ? 'text-green-700' : app.score >= 50 ? 'text-amber-600' : 'text-red-600' }}">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                        </svg>
                                        {{ app.score }}
                                    </span>
                                {% else %}
                                    <span data-testid="application-score" class="text-gray-400 text-sm">—</span>
                                {% endif %}
                            </td>
                            <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-500">{{ app.appliedAt|date('Y-m-d H:i') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
