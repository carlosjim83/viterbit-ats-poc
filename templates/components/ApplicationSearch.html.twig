<div {{ attributes }} class="max-w-6xl mx-auto p-6" data-controller="application-list">
    <h1 class="text-2xl font-bold mb-6">Job Applications</h1>

    <form class="mb-6 flex gap-4 flex-wrap items-end" data-action="submit->prevent">
        <div>
            <label for="status" class="block text-sm font-medium mb-1">Status</label>
            <select name="status" id="status" data-model="status" data-action="change->application-list#filter" class="border rounded px-3 py-2">
                <option value="" {% if status == '' %}selected{% endif %}>All</option>
                <option value="received" {% if status == 'received' %}selected{% endif %}>Received</option>
                <option value="enriching" {% if status == 'enriching' %}selected{% endif %}>Enriching</option>
                <option value="enriched" {% if status == 'enriched' %}selected{% endif %}>Enriched</option>
            </select>
        </div>

        <div>
            <label for="position" class="block text-sm font-medium mb-1">Position</label>
            <input type="text" name="position" id="position" data-model="position" data-action="input->application-list#filter" value="{{ position }}" placeholder="Any position" class="border rounded px-3 py-2">
        </div>

        <div>
            <label for="search" class="block text-sm font-medium mb-1">Search</label>
            <input type="text" name="search" id="search" data-model="search" data-action="input->application-list#filter" value="{{ search }}" placeholder="Name or email" class="border rounded px-3 py-2">
        </div>

        <button type="button" data-action="click->application-list#clear" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 rounded text-sm">
            Clear
        </button>
    </form>

    {% if this.applications is empty %}
        <p class="text-gray-600">No applications found.</p>
    {% else %}
        <table class="w-full border-collapse border border-gray-300">
            <thead>
                <tr class="bg-gray-100">
                    <th class="border border-gray-300 px-4 py-2 text-left cursor-pointer hover:bg-gray-200" data-action="click->application-list#sort" data-application-list-column-param="fullName">
                        Name <span class="text-gray-400">↕</span>
                    </th>
                    <th class="border border-gray-300 px-4 py-2 text-left">Email</th>
                    <th class="border border-gray-300 px-4 py-2 text-left cursor-pointer hover:bg-gray-200" data-action="click->application-list#sort" data-application-list-column-param="position">
                        Position <span class="text-gray-400">↕</span>
                    </th>
                    <th class="border border-gray-300 px-4 py-2 text-left cursor-pointer hover:bg-gray-200" data-action="click->application-list#sort" data-application-list-column-param="status">
                        Status <span class="text-gray-400">↕</span>
                    </th>
                    <th class="border border-gray-300 px-4 py-2 text-left cursor-pointer hover:bg-gray-200" data-action="click->application-list#sort" data-application-list-column-param="score">
                        Score <span class="text-gray-400">↕</span>
                    </th>
                    <th class="border border-gray-300 px-4 py-2 text-left cursor-pointer hover:bg-gray-200" data-action="click->application-list#sort" data-application-list-column-param="appliedAt">
                        Applied At <span class="text-gray-400">↕</span>
                    </th>
                </tr>
            </thead>
            <tbody>
                {% for app in this.applications %}
                    <tr class="hover:bg-gray-50">
                        <td class="border border-gray-300 px-4 py-2">
                            <a href="{{ path('application_detail', {id: app.id}) }}" class="text-blue-600 hover:underline">{{ app.fullName }}</a>
                        </td>
                        <td class="border border-gray-300 px-4 py-2">{{ app.email }}</td>
                        <td class="border border-gray-300 px-4 py-2">{{ app.position }}</td>
                        <td class="border border-gray-300 px-4 py-2">
                            <span class="inline-block px-2 py-1 text-xs rounded {{ app.status == 'enriched' ? 'bg-green-100 text-green-800' : app.status == 'enriching' ? 'bg-yellow-100 text-yellow-800' : 'bg-gray-100 text-gray-800' }}">
                                {{ app.status|capitalize }}
                            </span>
                        </td>
                        <td class="border border-gray-300 px-4 py-2">{{ app.score ?? '-' }}</td>
                        <td class="border border-gray-300 px-4 py-2">{{ app.appliedAt|date('Y-m-d H:i') }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</div>
