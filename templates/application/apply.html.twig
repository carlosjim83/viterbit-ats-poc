<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Apply for a Job — Viterbit ATS</title>
    <style>
        body { font-family: system-ui, sans-serif; max-width: 600px; margin: 2rem auto; padding: 0 1rem; }
        h1 { color: #333; }
        .field { margin-bottom: 1rem; }
        label { display: block; font-weight: 600; margin-bottom: 0.25rem; }
        input[type="text"], input[type="email"], textarea { width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px; font-size: 1rem; }
        textarea { min-height: 120px; resize: vertical; }
        button { padding: 0.75rem 1.5rem; background: #2563eb; color: white; border: none; border-radius: 4px; font-size: 1rem; cursor: pointer; }
        button:hover { background: #1d4ed8; }
        .error { color: #dc2626; font-size: 0.875rem; }
        .errors { background: #fef2f2; border: 1px solid #fecaca; padding: 1rem; border-radius: 4px; margin-bottom: 1rem; }
    </style>
</head>
<body>
    <h1>Apply for a Job</h1>

    {% if errors.general is defined %}
        <div class="errors">{{ errors.general }}</div>
    {% endif %}

    <form method="post" action="{{ path('apply') }}">
        <div class="field">
            <label for="fullName">Full Name</label>
            <input type="text" id="fullName" name="fullName" value="{{ data.fullName|default('') }}">
            {% if errors.fullName is defined %}<div class="error">{{ errors.fullName }}</div>{% endif %}
        </div>

        <div class="field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" value="{{ data.email|default('') }}">
            {% if errors.email is defined %}<div class="error">{{ errors.email }}</div>{% endif %}
        </div>

        <div class="field">
            <label for="phone">Phone</label>
            <input type="text" id="phone" name="phone" value="{{ data.phone|default('') }}">
            {% if errors.phone is defined %}<div class="error">{{ errors.phone }}</div>{% endif %}
        </div>

        <div class="field">
            <label for="position">Position</label>
            <input type="text" id="position" name="position" value="{{ data.position|default('') }}">
            {% if errors.position is defined %}<div class="error">{{ errors.position }}</div>{% endif %}
        </div>

        <div class="field">
            <label for="notes">Notes (optional)</label>
            <textarea id="notes" name="notes">{{ data.notes|default('') }}</textarea>
        </div>

        <div class="field">
            <label for="cvText">CV (paste as plain text)</label>
            <textarea id="cvText" name="cvText" placeholder="Paste your CV here...">{{ data.cvText|default('') }}</textarea>
            {% if errors.cvText is defined %}<div class="error">{{ errors.cvText }}</div>{% endif %}
        </div>

        <button type="submit">Submit Application</button>
    </form>
</body>
</html>
