{% extends 'base.html.twig' %}

{% block title %}Apply for a Job — Viterbit ATS{% endblock %}

{% block body %}
<div class="max-w-xl mx-auto p-6">
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-8">
        <h1 class="text-2xl font-bold text-gray-900 mb-1">Apply for a Job</h1>
        <p class="text-sm text-gray-500 mb-6">Fill in your details and paste your CV below.</p>

        {{ form_start(form, {'attr': {'class': 'space-y-5'}}) }}

            <div>
                {{ form_label(form.fullName, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.fullName, {'attr': {'class': 'w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 border'}}) }}
                {% if form.fullName.vars.errors|length > 0 %}
                    <p class="error mt-1 text-sm text-red-600">{{ form.fullName.vars.errors[0].message }}</p>
                {% endif %}
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                    {{ form_label(form.email, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_widget(form.email, {'attr': {'class': 'w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 border'}}) }}
                    {% if form.email.vars.errors|length > 0 %}
                        <p class="error mt-1 text-sm text-red-600">{{ form.email.vars.errors[0].message }}</p>
                    {% endif %}
                </div>

                <div>
                    {{ form_label(form.phone, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_widget(form.phone, {'attr': {'class': 'w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 border'}}) }}
                    {% if form.phone.vars.errors|length > 0 %}
                        <p class="error mt-1 text-sm text-red-600">{{ form.phone.vars.errors[0].message }}</p>
                    {% endif %}
                </div>
            </div>

            <div>
                {{ form_label(form.position, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.position, {'attr': {'class': 'w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 border'}}) }}
                {% if form.position.vars.errors|length > 0 %}
                    <p class="error mt-1 text-sm text-red-600">{{ form.position.vars.errors[0].message }}</p>
                {% endif %}
            </div>

            <div>
                {{ form_label(form.notes, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.notes, {'attr': {'class': 'w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 border resize-y'}}) }}
            </div>

            <div>
                {{ form_label(form.cvText, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.cvText, {'attr': {'class': 'w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 border resize-y', 'placeholder': 'Paste your CV here...'}}) }}
                {% if form.cvText.vars.errors|length > 0 %}
                    <p class="error mt-1 text-sm text-red-600">{{ form.cvText.vars.errors[0].message }}</p>
                {% endif %}
            </div>

            <div class="flex items-center gap-4 pt-2">
                <button type="submit" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
                    Submit Application
                </button>
                <a href="{{ path('applications_list') }}" class="text-sm text-gray-500 hover:text-gray-700 transition-colors">
                    View all applications →
                </a>
            </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
