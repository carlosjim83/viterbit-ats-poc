{% extends 'base.html.twig' %}

{% block title %}{{ application.fullName }} — Viterbit ATS{% endblock %}

{% block body %}
<div class="max-w-3xl mx-auto p-6">
    <div class="mb-6">
        <a href="{{ path('applications_list') }}" class="inline-flex items-center text-sm text-gray-500 hover:text-gray-700 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Back to applications
        </a>
    </div>

    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
        <!-- Header -->
        <div class="px-6 py-5 border-b border-gray-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">{{ application.fullName }}</h1>
                <p class="text-sm text-gray-500 mt-0.5">{{ application.position }}</p>
            </div>
            <div class="flex items-center gap-3">
                {% if application.status == 'enriched' %}
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                        <span class="w-1.5 h-1.5 mr-1.5 rounded-full bg-green-600"></span>
                        Enriched
                    </span>
                    {% if application.score is not null %}
                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-gray-100 {{ application.score >= 80 ? 'text-green-700' : application.score >= 50 ? 'text-amber-600' : 'text-red-600' }}">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                            </svg>
                            {{ application.score }}
                        </span>
                    {% endif %}
                {% elseif application.status == 'enriching' %}
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">
                        <span class="w-1.5 h-1.5 mr-1.5 rounded-full bg-amber-600"></span>
                        Enriching
                    </span>
                {% else %}
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                        <span class="w-1.5 h-1.5 mr-1.5 rounded-full bg-gray-500"></span>
                        Received
                    </span>
                {% endif %}
            </div>
        </div>

        <!-- Personal Info -->
        <div class="px-6 py-5 border-b border-gray-200">
            <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">Contact Information</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <p class="text-xs text-gray-500 mb-0.5">Email</p>
                    <p class="text-sm text-gray-900">{{ application.email }}</p>
                </div>
                <div>
                    <p class="text-xs text-gray-500 mb-0.5">Phone</p>
                    <p class="text-sm text-gray-900">{{ application.phone }}</p>
                </div>
                <div>
                    <p class="text-xs text-gray-500 mb-0.5">Position</p>
                    <p class="text-sm text-gray-900">{{ application.position }}</p>
                </div>
                <div>
                    <p class="text-xs text-gray-500 mb-0.5">Applied At</p>
                    <p class="text-sm text-gray-900">{{ application.appliedAt|date('Y-m-d H:i') }}</p>
                </div>
                {% if application.notes %}
                    <div class="sm:col-span-2">
                        <p class="text-xs text-gray-500 mb-0.5">Notes</p>
                        <p class="text-sm text-gray-900">{{ application.notes }}</p>
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- CV -->
        <div class="px-6 py-5 border-b border-gray-200">
            <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">CV</h2>
            <div class="bg-gray-50 rounded-md border border-gray-200 p-4 max-h-96 overflow-y-auto">
                <pre class="text-sm text-gray-700 whitespace-pre-wrap font-sans leading-relaxed">{{ application.cvText }}</pre>
            </div>
        </div>

        <!-- Enrichment Results -->
        {% if application.summary or application.score is not null %}
            <div class="px-6 py-5">
                <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">Enrichment Results</h2>
                <div class="bg-green-50 rounded-md border border-green-200 p-4">
                    {% if application.summary %}
                        <p class="text-sm text-gray-800 leading-relaxed mb-3">{{ application.summary }}</p>
                    {% endif %}
                    {% if application.score is not null %}
                        <div class="flex items-center gap-2">
                            <span class="text-xs text-gray-500">AI Score:</span>
                            <span class="inline-flex items-center gap-1 text-sm font-bold {{ application.score >= 80 ? 'text-green-700' : application.score >= 50 ? 'text-amber-600' : 'text-red-600' }}">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                </svg>
                                {{ application.score }}/100
                            </span>
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
